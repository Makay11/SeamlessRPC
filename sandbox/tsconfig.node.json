{
	"extends": ["@tsconfig/bases/node24", "@tsconfig/bases/strictest"],
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*"
	],
	"compilerOptions": {
		"noEmit": true,

		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"]
	}
}
