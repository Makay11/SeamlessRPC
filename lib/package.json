{
	"name": "seamlessrpc",
	"version": "1.1.0",
	"description": "An RPC library for quick development of seamless full-stack applications.",
	"keywords": [
		"vite",
		"typescript",
		"rpc",
		"subscriptions",
		"sse",
		"server-sent-events",
		"real-time"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Makay11/SeamlessRPC.git"
	},
	"license": "MPL-2.0",
	"author": "Diogo Pais",
	"type": "module",
	"exports": {
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./hono": {
			"types": "./dist/hono.d.ts",
			"import": "./dist/hono.js"
		},
		"./result": {
			"types": "./dist/result.d.ts",
			"import": "./dist/result.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./vue": {
			"types": "./dist/vue.d.ts",
			"import": "./dist/vue.js"
		},
		"./zod": {
			"types": "./dist/zod.d.ts",
			"import": "./dist/zod.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsc -p tsconfig.lib.json --watch",
		"validate": "pnpm type-check && pnpm lint && pnpm test && knip && pnpm format:check",
		"type-check": "tsc -p tsconfig.test.json",
		"type-check:watch": "pnpm type-check --watch",
		"lint": "eslint --max-warnings=0",
		"lint:fix": "pnpm lint --fix",
		"test": "node --test --experimental-test-coverage --experimental-test-module-mocks --experimental-strip-types --disable-warning=ExperimentalWarning",
		"test:watch": "node --test --watch --experimental-test-module-mocks --experimental-strip-types --disable-warning=ExperimentalWarning",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "rm -rf dist/* && tsc -p tsconfig.lib.json",
		"postbuild": "pnpm validate && publint",
		"prepublish": "pnpm build"
	},
	"dependencies": {
		"eventsource-parser": "^3.0.8",
		"tinyglobby": "^0.2.16",
		"type-fest": "^4.41.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@total-typescript/shoehorn": "^0.1.2",
		"@tsconfig/bases": "^1.0.24",
		"@types/node": "~24.12.4",
		"eslint": "^9.39.4",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-command": "^3.5.2",
		"eslint-plugin-depend": "^1.5.0",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-jsonc": "^2.21.1",
		"eslint-plugin-n": "^17.24.0",
		"eslint-plugin-package-json": "^0.45.2",
		"eslint-plugin-regexp": "^2.10.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"hono": "^4.12.21",
		"knip": "^5.88.1",
		"prettier": "^3.8.3",
		"publint": "^0.3.21",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^7.3.3",
		"vue": "^3.5.34",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"hono": "^4.8.1",
		"vite": "^6.3.5 || ^7.0.5",
		"vue": "^3.5.17",
		"zod": "^3.25.67 || ^4.0.5"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		},
		"vue": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
	"engines": {
		"node": ">=24"
	}
}
